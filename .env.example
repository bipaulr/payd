# PayPal sandbox REST app
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Fill after you create the webhook in the PayPal dashboard (after P1)
PAYPAL_WEBHOOK_ID=

# Sandbox personal account emails (the "vendors")
PAYOUT_SMOKE_EMAIL=
DEMO_VENDOR_EMAIL_1=
DEMO_VENDOR_EMAIL_2=
DEMO_VENDOR_EMAIL_3=

# Vision model (free tier via Google AI Studio). Confirm the current model id in AI Studio
GEMINI_API_KEY=
VISION_MODEL=gemini-3.8-flash

# Postgres. Leave empty to use a local Docker Postgres (Docker must be running)
DATABASE_URL=

# Public URL of the deployed app. Fill after connecting Render
APP_URL=

# Optional
AG_GRID_LICENSE_KEY=
